{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-nova",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "app/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@watermelon": "https://registry.watermelon.sh/r/{name}.json",
    "@remocn": "https://remocn.dev/r/{name}.json",
    "@aceternity": "https://ui.aceternity.com/registry/{name}.json",
    "@snapcn": {
      "url": "https://snapcn.dev/r/{name}.json",
      "headers": {
        "Authorization": "Bearer ${SNAPCN_API_KEY}",
        "x-api-key": "${SNAPCN_API_KEY}"
      }
    }
  }
}
